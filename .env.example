# Copy to .env and fill in values.  .env is git-ignored; this template is committed.

# ---- APIM gateway ----
GATEWAY_WS_URL=wss://<your-apim>.azure-api.net/voice-agent
APIM_SUBSCRIPTION_KEY=<apim-subscription-key>

# ---- Model mode (OPTIONAL) — native speech-to-speech, e.g. gpt-realtime ----
# Leave BOTH unset to run agent mode only. When set, the backend exposes a second
# WebSocket route (/realtime-model) and the browser UI shows a mode toggle.
# This is a SEPARATE APIM API + subscription so it never collides with agent mode.
# NOTE: Custom Neural Voice (VOICE_TYPE=azure-custom below) is NOT available in
# model mode — native models only expose their built-in voices. Use agent mode
# for CNV. See README "Voice Live has two modes".
# GATEWAY_WS_URL_MODEL=wss://<your-apim>.azure-api.net/voice-agent-model
# APIM_SUBSCRIPTION_KEY_MODEL=<apim-subscription-key-for-model-api>
# System prompt handed to the native model on connect (model mode has no agent):
# MODEL_MODE_INSTRUCTIONS=You are a helpful, concise voice assistant.
# Built-in voice for model mode (model mode ignores VOICE_TYPE=azure-custom):
# MODEL_MODE_VOICE=en-US-Ava:DragonHDLatestNeural

# ---- Voice selection for AGENT mode (OPTIONAL) ----
# Leave unset to use the voice configured on the Foundry agent. Set these to
# override the TTS voice from the backend without touching the agent.
#   VOICE_TYPE=standard      -> {"name": VOICE_NAME, "type": "azure-standard"}
#   VOICE_TYPE=azure-custom  -> Custom Neural Voice (requires VOICE_CUSTOM_ENDPOINT_ID)
# VOICE_TYPE=standard
# VOICE_NAME=en-US-AvaNeural
# Custom Neural Voice deployment (endpoint) id — only for VOICE_TYPE=azure-custom:
# VOICE_CUSTOM_ENDPOINT_ID=<cnv-endpoint-guid>

# ---- Backend server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---- Latency tuning (OPTIONAL) ----
# Turn detection / VAD — the #1 *perceived* latency lever. After you stop talking,
# server VAD waits this many ms of silence before ending the turn and letting the
# model respond. Lower = snappier replies; too low = it cuts you off mid-sentence.
# Model mode always applies these. Agent mode leaves VAD to the Foundry agent unless
# VAD_APPLY_AGENT=true (keeps default agent behavior unchanged when off).
# VAD_TYPE=server_vad            # server_vad | azure_semantic_vad
# VAD_SILENCE_MS=200             # end-of-turn silence (default ~500 upstream)
# VAD_PREFIX_PADDING_MS=200      # audio kept before speech start
# VAD_THRESHOLD=0.5              # 0.0-1.0 speech probability to trigger
# VAD_APPLY_AGENT=false          # set true to also override the agent's VAD
#
# Mic uplink batching (browser): ms of audio per WebSocket frame. Larger = fewer,
# bigger messages (less CPU/GC jitter) for a few ms of buffering. Set in web/config.js
# as VOICE_AGENT_CONFIG.micBatchMs (default 20). 0/unset -> 20 ms.

# ---- Local proxy test target (scripts/test_proxy.py) ----
BACKEND_WS_URL=ws://127.0.0.1:8000/realtime

# ---- Foundry agent (source of truth for the APIM policy + direct scripts) ----
FOUNDRY_WS_HOST=wss://<your-foundry-resource>.services.ai.azure.com
AGENT_NAME=<agent-name>
AGENT_PROJECT_NAME=<foundry-project-name>
VOICELIVE_API_VERSION=2026-04-10
VOICELIVE_SDK_API_VERSION=2026-01-01-preview
# Optional: ASR model for scripts/voice_profile.py (azure-speech | azure-mrs | mai-transcribe-1)
# INPUT_TRANSCRIPTION_MODEL=azure-speech

# ---- Application Insights tracing (OpenTelemetry) ----
# Leave unset to disable tracing. Get it from your App Insights resource.
APPLICATIONINSIGHTS_CONNECTION_STRING=<app-insights-connection-string>
OTEL_SERVICE_NAME=voice-agent-backend

# ---- Observability query targets (OPTIONAL) ----
# Only needed to RUN the diagnostic KQL in results/kql/ yourself. Not used by the
# app at runtime. One-time Azure setup required (see results/kql/README.md):
#   1. Create/choose a Log Analytics workspace.
#   2. On your APIM instance add a diagnostic setting that sends
#      "ApiManagementGatewayLogs" (Dedicated destination) to that workspace.
#   3. Fill in the GUIDs below (workspace "customerId" + App Insights appId).
#
# Log Analytics workspace that receives the APIM gateway logs (customerId GUID):
LOG_ANALYTICS_WORKSPACE_ID=<gateway-logs-workspace-guid>
LOG_ANALYTICS_WORKSPACE_NAME=<gateway-logs-workspace-name>
# App Insights "Application ID" for `az monitor app-insights query`:
APPINSIGHTS_APP_ID=<app-insights-application-id>
# If your App Insights is workspace-based, the backing LA workspace customerId
# (query AppDependencies here instead of the classic `dependencies` table):
APPINSIGHTS_WORKSPACE_ID=<app-insights-backing-workspace-guid>

