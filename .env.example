# Copy to .env and fill in values.  .env is git-ignored; this template is committed.

# ---- APIM gateway ----
GATEWAY_WS_URL=wss://<your-apim>.azure-api.net/voice-agent
APIM_SUBSCRIPTION_KEY=<apim-subscription-key>

# ---- Backend server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---- Local proxy test target (scripts/test_proxy.py) ----
BACKEND_WS_URL=ws://127.0.0.1:8000/realtime

# ---- Foundry agent (source of truth for the APIM policy + direct scripts) ----
FOUNDRY_WS_HOST=wss://<your-foundry-resource>.services.ai.azure.com
AGENT_NAME=<agent-name>
AGENT_PROJECT_NAME=<foundry-project-name>
VOICELIVE_API_VERSION=2026-04-10
VOICELIVE_SDK_API_VERSION=2026-01-01-preview
# Optional: ASR model for scripts/voice_profile.py (azure-speech | azure-mrs | mai-transcribe-1)
# INPUT_TRANSCRIPTION_MODEL=azure-speech

# ---- Application Insights tracing (OpenTelemetry) ----
# Leave unset to disable tracing. Get it from your App Insights resource.
APPLICATIONINSIGHTS_CONNECTION_STRING=<app-insights-connection-string>
OTEL_SERVICE_NAME=voice-agent-backend

# ---- Observability query targets (OPTIONAL) ----
# Only needed to RUN the diagnostic KQL in results/kql/ yourself. Not used by the
# app at runtime. One-time Azure setup required (see results/kql/README.md):
#   1. Create/choose a Log Analytics workspace.
#   2. On your APIM instance add a diagnostic setting that sends
#      "ApiManagementGatewayLogs" (Dedicated destination) to that workspace.
#   3. Fill in the GUIDs below (workspace "customerId" + App Insights appId).
#
# Log Analytics workspace that receives the APIM gateway logs (customerId GUID):
LOG_ANALYTICS_WORKSPACE_ID=<gateway-logs-workspace-guid>
LOG_ANALYTICS_WORKSPACE_NAME=<gateway-logs-workspace-name>
# App Insights "Application ID" for `az monitor app-insights query`:
APPINSIGHTS_APP_ID=<app-insights-application-id>
# If your App Insights is workspace-based, the backing LA workspace customerId
# (query AppDependencies here instead of the classic `dependencies` table):
APPINSIGHTS_WORKSPACE_ID=<app-insights-backing-workspace-guid>

